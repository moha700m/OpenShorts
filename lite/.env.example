# ---- LLM for viral-moment scoring (any OpenAI-compatible API). Leave empty for heuristic mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---- Transcription: auto | local | openai | none
TRANSCRIBER=auto
# faster-whisper model size: tiny, base, small, medium, large-v3
WHISPER_MODEL=small
# Used for TRANSCRIBER=openai (and as LLM key fallback)
OPENAI_API_KEY=

# ---- Server
OUTPUT_DIR=./output
# Comma-separated allowed origins for the web UI, e.g. https://openshorts-aoo.pages.dev
CORS_ORIGINS=*
# Regex for extra allowed origins (e.g. Pages preview deployments)
CORS_ORIGIN_REGEX=
# Optional shared secret. When set, all /api routes except /api/health require it
# (Authorization: Bearer <token>, X-Access-Token header, or ?token= query param)
OPENSHORTS_ACCESS_TOKEN=
